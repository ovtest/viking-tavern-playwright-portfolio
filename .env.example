# Copy this file to .env and fill it in.

# Where the tavern runs. The live tavern: http://fjords.oldbeaver.com:3102
# (If you run the tavern's code yourself, its dev server is http://localhost:3100.)
BASE_URL=http://fjords.oldbeaver.com:3102

# Your Viking's name. Swear the Oath ONCE by hand (the tavern's Swear the Oath page), then put the name here.
# The tests never swear the oath on their own (the tavern has room for 50 Vikings).
# The tests begin new sagas, book, pay and check out with this Viking, and set its Coin Pouch, so don't play with it.
VIKING_NAME=

# Optional, for npm run test:prod (always the live tavern, whatever BASE_URL says):
# PROD_URL=          another address for the live tavern (e.g. from inside its own home network)
# PROD_VIKING_NAME=  a different Viking for the live tavern than VIKING_NAME
