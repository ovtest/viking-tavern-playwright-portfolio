# Copy this file to .env and fill it in.

# Where the tavern runs. On your own computer (the app's dev server): http://localhost:3100
BASE_URL=http://localhost:3100

# Your Viking's name. Swear the Oath ONCE by hand (the tavern's Swear the Oath page), then put the name here.
# The tests never swear the oath on their own (the tavern has room for 50 Vikings).
# The tests begin new sagas, book, pay and check out with this Viking, and set its Coin Pouch, so don't play with it.
VIKING_NAME=
